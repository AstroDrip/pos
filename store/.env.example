# Copy to .env.local for this computer. Never commit real values. Nothing here may start with NEXT_PUBLIC_.

# ── Set on the host ───────────────────────────────────────────────
# Pooled connection logging in as store_app. Used by the shop and staff admin.
STORE_APP_DATABASE_URL=postgresql://store_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Pooled connection logging in as store_device. Used only by the /api/device routes the POS calls.
STORE_DEVICE_DATABASE_URL=postgresql://store_device:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Shown as the shop name.
STORE_DISPLAY_NAME=Online Store

# ── Only on your own computer, for npm run db:migrate and the scripts ─
# Direct (not pooled) owner connection. Never put this on the host.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# At least 16 characters each. Used to create the two login roles.
STORE_APP_PASSWORD=
STORE_DEVICE_PASSWORD=

# npm run staff:create
STAFF_USERNAME=
STAFF_DISPLAY_NAME=
# admin, supervisor or cashier
STAFF_ROLE=admin
# At least 12 characters.
STAFF_PASSWORD=

# ── Local testing only, with npm run dev:sql. Ignored in production ─
# NEON_LOCAL_ENDPOINT=http://localhost:4445/sql
