{
  "name": "pos-online-store",
  "version": "0.1.0",
  "private": true,
  "description": "Online shop and order administration connected to the store POS",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "staff:create": "node --env-file-if-exists=.env.local scripts/staff-create.ts",
    "device:code": "node --env-file-if-exists=.env.local scripts/device-code.ts",
    "dev:sql": "node scripts/dev-sql-server.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
