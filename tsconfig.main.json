{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "jsx": "preserve",
    "rootDir": "src",
    "outDir": "dist/main",
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["src/main", "src/preload", "src/core", "src/db", "src/services", "src/shared", "src/demo"],
  "exclude": ["**/*.test.ts"]
}
