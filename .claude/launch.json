{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dash-sql",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dashboard/scripts/dev-sql-server.ts"
      ],
      "port": 4444
    },
    {
      "name": "dash",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "dashboard",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "store-sql",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "store/scripts/dev-sql-server.ts"
      ],
      "port": 4445
    },
    {
      "name": "store",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "store",
        "run",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "store-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "store",
        "run",
        "start"
      ],
      "port": 3100
    }
  ]
}