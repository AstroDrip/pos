# Copy to .env.local for this computer. Never commit real values. Nothing here may start with NEXT_PUBLIC_.
# Full steps: DEPLOY.md

# ── Set on Vercel (Production and Preview) ──────────────────────────────────
# Pooled connection (host contains -pooler), logging in as dashboard_app. Real store figures. Leave empty for a demo-only site.
DASHBOARD_DATABASE_URL=postgresql://dashboard_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Pooled connection as device_api. Used only by the /api/device routes the till calls. Leave empty until a till is connected.
DEVICE_API_DATABASE_URL=postgresql://device_api:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── Set on Vercel only while testing the made-up demo ───────────────────────
# true turns on the demo login. false or empty turns it off completely.
DASHBOARD_DEMO_MODE=true
# Pooled connection as dashboard_demo. It can read the demo schema and nothing else.
DASHBOARD_DEMO_DATABASE_URL=postgresql://dashboard_demo:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── This computer only. Never add these to Vercel ───────────────────────────
# Direct connection (no -pooler) as the database owner. Migrate and seed scripts only.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Make these up: long, random and different from each other. Neon needs at least 60 bits of entropy.
DASHBOARD_APP_PASSWORD=
DASHBOARD_DEMO_PASSWORD=
DEVICE_API_PASSWORD=
# TEST password for the "demo" login. Do not reuse it anywhere.
DEMO_ADMIN_PASSWORD=
# The owner's real login, used by npm run owner:create.
OWNER_USERNAME=
OWNER_PASSWORD=
STORE_ID=
